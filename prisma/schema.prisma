// Data model from SPEC.md, "Tech stack and data model".
// Every row carries the anonymous sessionId so "Delete everything" can erase one user's data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Upload {
  id         String        @id @default(cuid())
  sessionId  String
  sourceType String // bank, paypal, apple, google, email
  fileName   String
  uploadedAt DateTime      @default(now())
  deletedAt  DateTime? // set as soon as the raw file has been parsed and discarded
  transactions Transaction[]

  @@index([sessionId])
}

model Transaction {
  id        String   @id @default(cuid())
  sessionId String
  uploadId  String
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Float // positive = money out (a charge), negative = refund or income
  currency  String
  rawLabel  String // encrypted at rest (AES-256-GCM), already masked
  source    String // bank, paypal, apple, google, email
  merchant  String? // encrypted; real merchant when the source reveals it
  plan      String? // encrypted; plan name from a receipt or app store list
  frequency String? // billing frequency stated by the source (receipts, app store lists)
  isTrial   Boolean  @default(false)
  isCancellation   Boolean   @default(false) // email saying the subscription was cancelled
  nextChargeDate   DateTime? // announced next charge: end of trial, renewal, price change
  nextChargeAmount Float?

  bankMatches         Match[] @relation("bankTx")
  intermediaryMatches Match[] @relation("intermediaryTx")

  @@index([sessionId])
}

model Subscription {
  id            String   @id @default(cuid())
  sessionId     String
  serviceName   String
  category      String?
  frequency     String // weekly, monthly, quarterly, yearly
  averageAmount Float
  currentAmount Float
  currency      String
  yearlyCost    Float
  firstSeen     DateTime
  lastSeen      DateTime
  status        String // active, idle, forgotten, cancelled
  confidence    Float
  usage         String? // answer to "Still using this?": yes, rarely, no
  labelKey      String // cleaned label the group was built from
  details       String // JSON: forgotten reasons, bundle parts, price history, cancellation URL

  @@index([sessionId])
}

model Match {
  id                   String      @id @default(cuid())
  sessionId            String
  bankTransactionId    String
  bankTransaction      Transaction @relation("bankTx", fields: [bankTransactionId], references: [id], onDelete: Cascade)
  intermediaryTransactionId String
  intermediaryTransaction   Transaction @relation("intermediaryTx", fields: [intermediaryTransactionId], references: [id], onDelete: Cascade)
  confidence           Float
  candidateCount       Int

  @@index([sessionId])
}

model Descriptor {
  id              String  @id @default(cuid())
  sessionId       String // user-provided labels are private to the session that answered them
  pattern         String
  serviceName     String
  category        String?
  cancellationUrl String?

  @@unique([sessionId, pattern])
}

// A free trial the user told us about ("I just started a trial, it ends on ..."), so we can remind them.
model TrackedTrial {
  id          String   @id @default(cuid())
  sessionId   String
  serviceName String // encrypted
  endsOn      DateTime
  priceAfter  Float?
  currency    String   @default("EUR")
  frequency   String?
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

// Onboarding answers: how the user pays and where receipts go (encrypted JSON), so the
// checklist of what to upload survives a reload. Deleted with everything else.
model Profile {
  sessionId String   @id
  answers   String // encrypted JSON, known ids only
  updatedAt DateTime @updatedAt
}

// A bank access kept open (up to 90 days) because the user asked to be watched: read again every
// night to spot new subscriptions and price increases. The provider's session id and account ids
// are encrypted; stopping the watch or "Delete everything" closes the access at the provider.
model BankLink {
  id          String   @id @default(cuid())
  sessionId   String
  provider    String // enable-banking, demo
  institution String // encrypted bank name
  access      String // encrypted JSON: provider session id and account ids
  alertEmail  String? // encrypted, optional
  locale      String   @default("fr")
  validUntil  DateTime
  lastReadAt  DateTime
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

// What changed at a nightly read: a new subscription, a price increase, a subscription restarting.
model Alert {
  id        String    @id @default(cuid())
  sessionId String
  kind      String // new, price-up, restarted
  details   String // encrypted JSON: service, amounts, currency, frequency, date
  createdAt DateTime  @default(now())
  seenAt    DateTime?

  @@index([sessionId])
}

// An account, opened by a sign-in link sent by e-mail (no password). It ties one e-mail to one
// session id, so the same data opens on another device. The e-mail is stored encrypted; emailHash
// (an HMAC of the lower-cased address) finds the account without decrypting every row.
model Account {
  id          String    @id @default(cuid())
  emailHash   String    @unique
  email       String // encrypted
  sessionId   String    @unique
  plan        String    @default("free") // free, premium
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  // Stripe: the customer, the subscription's state and the end of the period paid for. Set by
  // the webhook only; billingEventAt keeps an older event that arrives late from undoing a newer one.
  stripeCustomerId   String?   @unique
  subscriptionStatus String?
  premiumUntil       DateTime?
  billingEventAt     Int?
}

// A sign-in link waiting to be opened: only the hash of its token is kept, it works once, for 15 minutes.
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  emailHash String
  email     String // encrypted
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([emailHash])
}

// The app's own ad space: campaigns sold directly to advertisers (no ad network). Targeting is
// contextual only, decided in the app from the categories of the subscriptions it found; nothing
// about a user is stored with an ad or sent to the advertiser.
model AdCampaign {
  id             String   @id @default(cuid())
  advertiser     String
  name           String
  format         String // story, short, card
  categories     String   @default("") // comma-separated subscription categories; empty: everyone
  title          String
  body           String
  cta            String
  url            String // https landing page
  mediaUrl       String? // video (mp4, webm) or image
  mediaKind      String? // video, image
  posterUrl      String?
  pricing        String // cpm, cpc, cpa
  rate           Float // € HT per 1 000 impressions, per click or per conversion
  budget         Float // € HT at most; the campaign stops once spent
  startsOn       DateTime
  endsOn         DateTime
  status         String   @default("active") // active, paused
  postbackSecret String // the advertiser's key to report a conversion
  createdAt      DateTime @default(now())
}

// Counters per campaign and per day, nothing per person.
model AdStat {
  campaignId  String
  day         String // YYYY-MM-DD
  impressions Int    @default(0)
  views       Int    @default(0) // a story or a short watched to the end
  clicks      Int    @default(0)
  conversions Int    @default(0)
  revenue     Float  @default(0) // € HT earned
  @@id([campaignId, day])
}

// A click, under a random id passed to the advertiser so it can report a conversion. It holds
// no session, address or device: only the campaign and the time.
model AdClick {
  id          String    @id
  campaignId  String
  createdAt   DateTime  @default(now())
  convertedAt DateTime?

  @@index([campaignId])
}
