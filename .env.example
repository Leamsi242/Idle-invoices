# Local SQLite file, or a Turso/libSQL URL (libsql://...) for Vercel.
DATABASE_URL="file:./prisma/dev.db"
# Only needed for libsql:// URLs.
DATABASE_AUTH_TOKEN=""
# 32 random bytes, base64. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""
# Optional: enables reading app store screenshots with Claude vision.
ANTHROPIC_API_KEY=""
# Optional: one-time, read-only Gmail scan. OAuth client of type "Web application" in Google Cloud,
# with redirect URI https://<your-domain>/api/gmail/callback (http://localhost:3000/... locally).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: one-time, read-only Outlook / Hotmail scan. App registration in Microsoft Entra
# ("Accounts in any organizational directory and personal Microsoft accounts"), delegated
# permission Mail.Read, a client secret, redirect URI https://<your-domain>/api/outlook/callback.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional: read-only bank connection through Enable Banking (PSD2 account information).
# Application id and its private key (PEM; "\n" escapes are accepted), from enablebanking.com.
# Redirect URL to register: https://<your-domain>/api/bank/callback
ENABLE_BANKING_APP_ID=""
ENABLE_BANKING_PRIVATE_KEY=""
# Optional, to compare providers: Bridge (bridgeapi.io, sandbox app from the Bridge dashboard).
# Callback to register: https://<your-domain>/api/bank/callback. BRIDGE_USER_EMAIL: the contact
# e-mail Bridge requires on each connection (yours while testing).
BRIDGE_CLIENT_ID=""
BRIDGE_CLIENT_SECRET=""
BRIDGE_USER_EMAIL=""
# Optional: Powens (powens.com console). POWENS_DOMAIN is the domain name, e.g. "mine-sandbox"
# (".biapi.pro" is added). Redirect URI to allow on the client application:
# https://<your-domain>/api/bank/callback
POWENS_DOMAIN=""
POWENS_CLIENT_ID=""
POWENS_CLIENT_SECRET=""
# Which provider to use when several are configured: enable-banking, bridge or powens
# (default: the first configured, in that order).
BANK_PROVIDER=""
# "1" shows a made-up "Demo bank (test data)" to try the flow without a contract (on by default
# in development, "0" hides it).
BANK_DEMO=""
# Protects the daily retention purge (/api/cron/purge, scheduled in vercel.json). openssl rand -hex 32
CRON_SECRET=""
# Optional: alert emails for watched accounts, through Resend (resend.com). The sender must be on
# a domain verified in Resend, e.g. "Subscription Detective <alertes@your-domain>".
RESEND_API_KEY=""
ALERT_FROM=""
# Public address of the app, used in alert emails (defaults to the address the cron was called on).
APP_URL=""
# Premium payments through Stripe (docs/DEPLOIEMENT.md, section 6 bis). Test keys (sk_test_...)
# only: a live key (sk_live_...) is refused unless BILLING_LIVE=1. No publishable key is needed,
# the payment happens on Stripe's own page.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint https://<domain>/api/billing/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=""
# Price ids (price_...) of the Premium product: monthly is required, yearly optional.
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
BILLING_LIVE=""
# Closed beta (see docs/BETA.md). Empty values keep the defaults.
BETA_ACCESS_CODE=""
BETA_OWNER_CODE=""
# "owner" while Enable Banking is in restricted mode: testers import statements instead.
BETA_BANK_MODE=""
BETA_MAX_TESTERS=""
BETA_BANK_CONNECTIONS_PER_DAY=""
BETA_UPLOADS_PER_DAY=""
BETA_SCREENSHOTS_PER_DAY=""
BETA_SCREENSHOTS_PER_MONTH=""
BETA_MAX_WATCHES=""
# Model that reads app store screenshots. Default claude-opus-5; claude-haiku-4-5 costs about 10x less.
SCREENSHOT_MODEL=""
