# Local SQLite file, or a Turso/libSQL URL (libsql://...) for Vercel.
DATABASE_URL="file:./prisma/dev.db"
# Only needed for libsql:// URLs.
DATABASE_AUTH_TOKEN=""
# 32 random bytes, base64. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""
# Optional: enables reading app store screenshots with Claude vision.
ANTHROPIC_API_KEY=""
